{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "studio-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev:server"
      ],
      "env": {
        "STUDIO_PASSWORD": "demo",
        "PORT": "3000"
      },
      "port": 3000
    },
    {
      "name": "studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev:web"
      ],
      "port": 5173
    },
    {
      "name": "mock-comfy",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev:mock"
      ],
      "env": {
        "MOCK_DELAY_MS": "2500"
      },
      "port": 8188
    },
    {
      "name": "mock-comfy-h3",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev:mock"
      ],
      "env": {
        "MOCK_DELAY_MS": "2500",
        "MOCK_MINIMAX": "1"
      },
      "port": 8188
    },
    {
      "name": "mock-comfy-ltx",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev:mock"
      ],
      "env": {
        "MOCK_DELAY_MS": "2500",
        "MOCK_LTX": "1"
      },
      "port": 8188
    },
    {
      "name": "mock-tts",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev:tts"
      ],
      "env": {
        "MOCK_DELAY_MS": "1500"
      },
      "port": 8190
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "site"
      ],
      "port": 4173
    }
  ]
}
